# Variáveis de ambiente carregadas automaticamente pelo Vitest (mode "test").
#
# Sem VITE_MQTT_URL, o MqttProvider cai direto no modo "fallback" (simulação
# local) e nunca chama mqtt.connect() — quebrando os testes de
# MqttCommands.test.tsx, que mockam o módulo "mqtt" e esperam que connect()
# seja chamado para simular o evento "connect". O valor abaixo é fictício: o
# cliente MQTT real nunca é usado nos testes (módulo "mqtt" é mockado).
VITE_MQTT_URL=wss://test.invalid:8884/mqtt
VITE_MQTT_USERNAME=test
VITE_MQTT_PASSWORD=test
