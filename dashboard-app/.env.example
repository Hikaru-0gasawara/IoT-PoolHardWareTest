# Configuração do broker MQTT do dashboard AquaSense IoT.
#
# Copie este arquivo para `.env.local` (já no .gitignore — nunca commitado) e
# preencha com as credenciais do SEU cluster HiveMQ Cloud (mesmo cluster
# configurado no firmware AquaSense.ino, USAR_TLS 1).
#
# IMPORTANTE: NÃO commitar `.env.local` nem credenciais reais em nenhum
# arquivo versionado — o bundle Vite embute estas variáveis no JS público,
# então credenciais hardcoded no código-fonte ficam visíveis a qualquer
# visitante do dashboard implantado.
#
# Sem estas variáveis, o dashboard roda em modo simulação local (mesmo
# comportamento do modo demo público), nunca tenta conectar com credenciais
# vazias.

VITE_MQTT_URL=wss://SEU_CLUSTER.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=seu_usuario
VITE_MQTT_PASSWORD=sua_senha

# Modo demo público — defina como "true" SOMENTE no ambiente de produção da
# build pública (ex.: Cloudflare Pages). Nunca defina em .env.local pessoal.
# Ver README.md → "Modo demo público (VITE_PUBLIC_DEMO)".
# VITE_PUBLIC_DEMO=true
